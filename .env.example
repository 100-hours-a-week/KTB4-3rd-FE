# -----------------------------------------------------------------------------
# Browser-visible values. Next.js embeds these in the bundle at build time.
# For CI, register matching GitHub Actions Variables and pass them as Docker
# build arguments. These values are public in the resulting frontend bundle.
# -----------------------------------------------------------------------------
# Dev: http://dev.moyeota.com/api
# Production: http://moyeota.com/api
NEXT_PUBLIC_API_BASE_URL=http://dev.moyeota.com/api

# Kakao Maps JavaScript app key. Register the web domain in the Kakao Developers console.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Google Analytics 4 measurement ID (usually starts with G-)
NEXT_PUBLIC_GA_ID=

# Browser Sentry settings (build-time, public).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Sentry source-map upload settings (CI build only).
# SENTRY_ORG and SENTRY_PROJECT are GitHub Actions Variables.
# SENTRY_AUTH_TOKEN is a GitHub Actions Secret; do not put its real value here.
# -----------------------------------------------------------------------------
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Frontend server runtime settings. In EC2, set these in frontend.env.
# -----------------------------------------------------------------------------
# The public DSN and server DSN may point to the same Sentry project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
