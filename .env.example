# -----------------------------------------------------------------------------
# Browser-visible values. Next.js embeds these in the bundle at build time.
# For CI, register matching GitHub Actions Variables and pass them as Docker
# build arguments. These values are public in the resulting frontend bundle.
# -----------------------------------------------------------------------------
# Browser requests stay on the frontend origin and are rewritten by Next.js.
NEXT_PUBLIC_API_BASE_URL=/api
# Optional override. If omitted, the frontend appends /wss to NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_WEBSOCKET_URL=

# Server-side rewrite target. This value is not exposed to the browser.
API_PROXY_TARGET=http://dev.moyeota.com

# Canonical public frontend origin used by robots.txt and sitemap.xml at runtime.
# Set this in the frontend runtime environment (for example frontend.env).
SITE_URL=https://moyeota.com

# Kakao Maps JavaScript app key. Register the web domain in the Kakao Developers console.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Firebase Web app configuration for browser push token registration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_VAPID_KEY=

# Google Analytics 4 measurement ID (usually starts with G-)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID. Leave empty outside the production environment.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Browser Sentry settings (build-time, public).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Sentry source-map upload settings (CI build only).
# SENTRY_ORG and SENTRY_PROJECT are GitHub Actions Variables.
# SENTRY_AUTH_TOKEN is a GitHub Actions Secret; do not put its real value here.
# -----------------------------------------------------------------------------
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Frontend server runtime settings. In EC2, set these in frontend.env.
# -----------------------------------------------------------------------------
# The public DSN and server DSN may point to the same Sentry project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
