{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["eslint", "typescript", "oxc", "react", "vitest", "import", "promise", "nextjs"],
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock",
    "public/mockServiceWorker.js",
    ".agents/**",
    ".claude/**",
    "shared/skills/**",
    "shared/rules/**",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/**",
    ".github/**",
    ".next/**",
    "storybook-static/**",
    "playwright-report/**",
    "test-results/**"
  ],
  "overrides": [
    {
      "files": ["src/_app/**", "app/**", "scripts/sync-rules.mjs"],
      "rules": {
        "import/no-default-export": "off",
        "typescript/no-unsafe-member-access": "off",
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["**/*.stories.{ts,tsx}", ".storybook/**", "*.config.{ts,js,mjs}"],
      "rules": {
        "import/no-default-export": "off",
        "import/no-relative-parent-imports": "off"
      }
    }
  ],
  "rules": {
    "eslint/eqeqeq": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/curly": "error",
    "eslint/no-console": "warn",
    "eslint/no-alert": "error",
    "eslint/no-duplicate-imports": "error",
    "eslint/object-shorthand": "error",
    "eslint/prefer-template": "warn",
    "eslint/no-param-reassign": "error",
    "eslint/no-bitwise": "error",
    "eslint/no-unused-expressions": "error",
    "eslint/guard-for-in": "error",
    "eslint/array-callback-return": "error",
    "eslint/no-negated-condition": "error",
    "eslint/no-nested-ternary": "error",
    "eslint/no-template-curly-in-string": "error",
    "eslint/radix": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-empty": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-prototype-builtins": "error",
    "eslint/no-regex-spaces": "error",
    "eslint/prefer-rest-params": "error",
    "eslint/prefer-spread": "error",
    "eslint/prefer-arrow-callback": "error",
    "eslint/no-array-constructor": "error",
    "eslint/no-restricted-imports": "error",
    "eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "promise/no-new-statics": "error",
    "promise/valid-params": "warn",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-empty-object-type": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-for-of": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "off",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/restrict-template-expressions": [
      "error",
      { "allowNumber": true, "allowBoolean": true }
    ],
    "typescript/switch-exhaustiveness-check": "warn",
    "typescript/ban-ts-comment": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/await-thenable": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/require-await": "error",
    "typescript/return-await": "error",
    "typescript/dot-notation": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-regexp-exec": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/array-type": "error",
    "typescript/ban-tslint-comment": "error",
    "typescript/class-literal-property-style": "error",
    "typescript/consistent-generic-constructors": "error",
    "typescript/consistent-indexed-object-style": "error",
    "typescript/consistent-type-assertions": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/no-inferrable-types": "error",
    "typescript/prefer-function-type": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-namespace": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/unbound-method": "error",
    "typescript/no-useless-default-assignment": "off",
    "typescript/adjacent-overload-signatures": "error",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-boolean-value": "error",
    "react/jsx-curly-brace-presence": "error",
    "react/jsx-fragments": "error",
    "react/jsx-pascal-case": "error",
    "react/self-closing-comp": "error",
    "react/exhaustive-deps": "warn",
    "react/rules-of-hooks": "error",
    "import/no-cycle": "warn",
    "import/no-default-export": "warn",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-relative-parent-imports": "warn",
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/namespace": "off"
  }
}
