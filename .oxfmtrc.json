{
  "$schema": "https://oxc.rs/schema/oxfmt.json",
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "printWidth": 100,
  "arrowParens": "always",
  "useTabs": false,
  "sortTailwindcss": true,
  "sortPackageJson": true,
  "singleAttributePerLine": false
}
